# Bankism AI Firewall & Guardrail Defense — Environment Configuration
# Copy this file to .env and adjust values for local development.

# Application Environment
BANKISM_ENV=development
BANKISM_DEBUG=false
BANKISM_HOST=127.0.0.1
BANKISM_PORT=8000

# Security Boundaries
BANKISM_SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-key
BANKISM_MAX_REQUEST_BYTES=65536
BANKISM_MAX_PROMPT_CHARS=4000
BANKISM_MAX_TRANSACTION_LIMIT=1000.00
BANKISM_TOKEN_EXPIRATION_SECONDS=300

# Risk Thresholds (0-100 scale)
BANKISM_RISK_LOW_MAX=24
BANKISM_RISK_MEDIUM_MAX=59
BANKISM_RISK_HIGH_MAX=84

# Optional AI Classifier Integration (Defaults to robust deterministic/heuristic offline engine)
# Provider options: "heuristic", "gemini", "mock"
BANKISM_AI_PROVIDER=heuristic
GEMINI_API_KEY=your-gemini-api-key-here-optional
GEMINI_MODEL=gemini-1.5-flash
AI_CLASSIFIER_TIMEOUT_SECONDS=2.0
AI_FAIL_CLOSED=true

# Rate Limiting
BANKISM_RATE_LIMIT_PER_MINUTE=120
